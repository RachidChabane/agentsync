# Your private policy lives here (copied from config.example by init, or symlinked to a
# private config repo). Never published. No trailing slash: git lstats a symlink as a
# file, so `/config/` would leave the link itself untracked and leak its target path.
/config

__pycache__/
*.pyc

# Python packaging artifacts (pyproject.toml build)
/build/
/dist/
# packed plugin output of the example bundles (agentsync pack's default --out)
/examples/*/dist/
*.egg-info/
*.bak
*.bak[0-9]*

# Local analysis notes (not published)
/docs/market-analysis-2026.md
